{
  "manifest_version": 3,
  "name": "文献自动下载器",
  "version": "1.3",
  "description": "自动下载ACS和Nature期刊文献",
  "permissions": [
    "downloads",
    "tabs",
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://pubs.acs.org/*",
    "https://www.nature.com/*",
    "https://pubs.rsc.org/*",
    "https://static-content.springer.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pubs.acs.org/*",
        "https://www.nature.com/*",
        "https://pubs.rsc.org/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["query.txt", "blacklist.txt"],
      "matches": ["<all_urls>"]
    }
  ]
}